# Local dev default: leave unset to use SQLite (./dev.db) with zero setup.
# For Postgres (recommended before deployment), e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/executive_assistant
DATABASE_URL=

GEMINI_API_KEY=your-key-here
# Model availability on the free tier shifts often. gemini-3.5-flash-lite
# is confirmed working as of Aug 2026 — if you get a 404 "model not found",
# try gemini-2.5-flash-lite, or check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

FRONTEND_ORIGIN=http://localhost:3000
